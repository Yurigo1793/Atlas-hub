   <string notr="true">* {
    font-family: System;
    font-size: 12pt;
}

QMainWindow {
    background-color: #F0EEE6;
}

QMenuBar {
    background-color: #F0EEE6;
    border: 2px solid #111111;
    font-weight: bold;
}

QMenuBar::item {
    background: transparent;
    padding: 2px 10px;
}

QMenuBar::item:selected {
    background: #111111;
    color: #FFFFFF;
}

QMenu {
    background: #F0EEE6;
    color: #111111;
    border: 2px solid #111111;
    font-weight: bold;
}

QMenu::item {
    padding: 4px 26px 4px 16px;
}

QMenu::item:selected {
    background: #00FF66;
    color: #111111;
}

QToolBar {
    background: #FFFFFF;
    border-top: 2px solid #adadad;
    border-left: 2px solid #adadad;
    border-right: 4px solid #000000;
    border-bottom: 4px solid #000000;
    padding: 6px;
    spacing: 6px;
}

QLabel, QLineEdit, QComboBox, QTextEdit, QPlainTextEdit, QListWidget {
    background: #FFFFFF;
    color: #111111;
    border: 2px solid #111111;
    font-weight: bold;
}

QTextEdit, QPlainTextEdit, QListWidget {
    padding: 4px;
}

QPushButton, QToolButton {
    background: #FFFFFF;
    color: #111111;
    border-top: 2px solid #adadad;
    border-left: 2px solid #adadad;
    border-right: 4px solid #000000;
    border-bottom: 4px solid #000000;
    padding: 4px 8px;
    font-weight: bold;
}

QPushButton:pressed, QToolButton:pressed {
    border-top: 4px solid #000000;
    border-left: 4px solid #000000;
    border-right: 2px solid #adadad;
    border-bottom: 2px solid #adadad;
    padding-top: 6px;
    padding-left: 10px;
    padding-right: 6px;
    padding-bottom: 2px;
}

QPushButton#btnRunOCR, QPushButton#btnTranslate {
    background-color: #00FF66;
}

QDockWidget {
    background-color: #F0EEE6;
    color: #111111;
    font-weight: bold;
}

QDockWidget::title {
    background: #F0EEE6;
    border: 2px solid #111111;
    padding: 2px;
}</string>
