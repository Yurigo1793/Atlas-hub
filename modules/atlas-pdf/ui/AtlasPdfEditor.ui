  <property name="styleSheet">
   <string notr="true">* {
    font-family: System;
    font-size: 9pt;
}

QWidget#AtlasPdfEditor {
    background-color: #F0EEE6;
    color: #111111;
}

QLabel {
    color: #111111;
    font-weight: bold;
}

QFrame#pdfRibbon,
QFrame#pdfStatusFrame {
    background: #FFFFFF;
    border-top: 2px solid #adadad;
    border-left: 2px solid #adadad;
    border-right: 4px solid #000000;
    border-bottom: 4px solid #000000;
}

QGroupBox {
    background: #FFFFFF;
    color: #111111;
    border: 2px solid #111111;
    margin-top: 14px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    left: 8px;
    background: #F0EEE6;
}

QPushButton, QToolButton {
    background: #FFFFFF;
    color: #111111;
    border-top: 2px solid #adadad;
    border-left: 2px solid #adadad;
    border-right: 4px solid #000000;
    border-bottom: 4px solid #000000;
    padding: 3px 8px;
    font-weight: bold;
}

QPushButton:disabled, QToolButton:disabled {
    color: #777777;
    background: #E8E6DE;
}

QPushButton:pressed, QToolButton:pressed {
    border-top: 4px solid #000000;
    border-left: 4px solid #000000;
    border-right: 2px solid #adadad;
    border-bottom: 2px solid #adadad;
    padding-top: 5px;
    padding-left: 10px;
    padding-right: 6px;
    padding-bottom: 1px;
}

QPushButton#btnOpenPdf,
QPushButton#btnApplyOcr {
    background-color: #00FF66;
}

QLineEdit, QComboBox, QTextEdit, QPlainTextEdit, QListWidget, QTabWidget::pane {
    background: #FFFFFF;
    color: #111111;
    border: 2px solid #111111;
    selection-background-color: #88C7FF;
    selection-color: #000000;
}

QTextEdit, QPlainTextEdit, QListWidget {
    padding: 4px;
}

QTabBar::tab {
    background: #E8E6DE;
    color: #111111;
    border: 2px solid #111111;
    padding: 5px 10px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    border-bottom-color: #FFFFFF;
}

QListWidget::item {
    padding: 4px 6px;
}

QListWidget::item:selected {
    background: #88C7FF;
    color: #000000;
}

QSplitter::handle {
    background: #D4D0C8;
}

QSlider::groove:horizontal {
    height: 5px;
    background: #D4D0C8;
    border: 1px solid #111111;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -6px 0;
    background: #0088FF;
    border: 2px solid #111111;
}</string>
